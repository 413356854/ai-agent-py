# ============================================================================
# ai-agent-py 配置示例：复制为 .env 后按需修改
#   Copy-Item .env.example .env        (PowerShell)
#   cp .env.example .env               (bash)
# 所有字段都可以用真实环境变量覆盖。
# ============================================================================

APP_ENV=dev
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# MySQL（文档解析任务记录表 tb_document_parse_job；建表脚本在 docs/mysql/）
#   支持 Java 的 jdbc:mysql:// 写法，也支持 mysql+pymysql://
#   应用不会自动建表：先执行 docs/mysql/tb_document_parse_job.sql
#   `ai-agent-py db check` 或 GET /api/db/health 会实际连一次并返回库信息。
# ---------------------------------------------------------------------------
MYSQL_URL=jdbc:mysql://localhost:3306/db_py_agent?useUnicode=true&characterEncoding=utf8&connectionTimeZone=Asia/Shanghai&allowPublicKeyRetrieval=true&useSSL=false
MYSQL_USERNAME=admin
MYSQL_PASSWORD=change-me
MYSQL_POOL_SIZE=5
MYSQL_MAX_OVERFLOW=10
MYSQL_POOL_RECYCLE=1800
MYSQL_CONNECT_TIMEOUT=5

# ---------------------------------------------------------------------------
# 对话模型：任何兼容 OpenAI 接口的服务都能用
#   LLM_API_KEY 留空时依次回退到环境变量 DASHSCOPE_API_KEY、OPENAI_API_KEY
#   （只设置 DASHSCOPE_API_KEY 也能启动对话模型，无需再复制一份 Key）
# ---------------------------------------------------------------------------
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
# 通用 Agent 专用模型（可选）：需要处理用户上传图片时必须支持视觉，例如 qwen3-vl-plus / gpt-4o；
# 留空跟随 LLM_MODEL。通用 Agent 的图片会按 LangChain 标准 image 内容块发送。
GENERAL_AGENT_MODEL=
# LLM_BASE_URL=                     # 留空 = https://api.openai.com/v1
LLM_TEMPERATURE=0
# LLM_MAX_TOKENS=2048
LLM_TIMEOUT=60

# 国内常用组合（取消注释即可）：
#   DeepSeek:      LLM_BASE_URL=https://api.deepseek.com/v1     LLM_MODEL=deepseek-chat
#   通义千问:      LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
#                  Key 直接导出环境变量 DASHSCOPE_API_KEY 即可
#   本地 Ollama:   LLM_BASE_URL=http://localhost:11434/v1       LLM_MODEL=qwen2.5:7b   LLM_API_KEY=ollama

# ---------------------------------------------------------------------------
# 向量模型（负责把文本变成向量，必须与知识库使用同一个模型）
#   默认对接阿里云百炼 text-embedding-v4（OpenAI 兼容模式）：
#     1. 在阿里云百炼控制台创建 API Key；
#     2. 设置环境变量 DASHSCOPE_API_KEY（推荐），或填到下面的 EMBEDDING_API_KEY；
#     3. EMBEDDING_DIMENSIONS 必须与 MILVUS_DIM 一致（v4 支持 1536/1024/768...）。
# ---------------------------------------------------------------------------
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_BASE_URL=https://ws-9lonm8753e95w4oc.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=
DASHSCOPE_API_KEY=
EMBEDDING_DIMENSIONS=1536       # 留空 = 模型默认（v4 为 1024），必须与 MILVUS_DIM 一致
EMBEDDING_BATCH_SIZE=10         # 百炼兼容接口单次最多 10 条文本

# 其他常用组合：
#   OpenAI:       EMBEDDING_BASE_URL= (留空)  EMBEDDING_MODEL=text-embedding-3-small  EMBEDDING_DIMENSIONS=
#   硅基流动:     EMBEDDING_BASE_URL=https://api.siliconflow.cn/v1   EMBEDDING_MODEL=BAAI/bge-m3
#   本地 Ollama:  EMBEDDING_BASE_URL=http://localhost:11434/v1        EMBEDDING_MODEL=nomic-embed-text
# 注意：DeepSeek 目前不提供 embedding 接口，向量模型需要单独配置。

# ---------------------------------------------------------------------------
# 数据目录与切分
#   Milvus 是唯一向量库：本地目录建索引、文档解析入库都写 db_tax_rag.rag_chunk。
# ---------------------------------------------------------------------------
DATA_DIR=data/raw

# 分块（中文文档 500~1000 字符是比较稳妥的起点）
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# 检索（最终交给模型的片段数；Milvus 侧先召回 MILVUS_CANDIDATES 条再 RRF/精排）
RETRIEVER_K=4

# ---------------------------------------------------------------------------
# Milvus（唯一向量库：本地目录建索引、文档解析入库都写入 db_tax_rag.rag_chunk）
#   建表脚本 docs/milvus/create_rag_chunk.py
#   先建表：uv run python docs/milvus/create_rag_chunk.py --dim 1536
# ---------------------------------------------------------------------------
MILVUS_URI=http://localhost:19530        # Zilliz Cloud 填公网 Endpoint
# MILVUS_TOKEN=                           # 自建可留空；Zilliz 填 API Key
MILVUS_DATABASE=db_tax_rag               # 建库脚本 docs/milvus/create_database.py
MILVUS_COLLECTION=rag_chunk
MILVUS_DIM=1536                  # 必须等于 EMBEDDING_MODEL 的输出维度
MILVUS_METRIC=COSINE             # COSINE | IP（向量已归一化时）| L2
MILVUS_TENANT=default            # 预留：多租户时给 rag_chunk 加 tenant_id 再用
MILVUS_KB=default                # 预留：多知识库时给 rag_chunk 加 kb_id 再用
MILVUS_NUM_PARTITIONS=16         # 预留：仅当表里有分区键字段时生效
MILVUS_ANALYZER=chinese          # chinese | english | standard（建表后不能改）
MILVUS_BATCH_SIZE=500
MILVUS_CANDIDATES=30             # 每路召回候选数，建议 k 的 3~5 倍
MILVUS_EF=64                     # HNSW 查询参数，越大越准越慢
MILVUS_RRF_K=60                  # RRF 融合常数

# ---------------------------------------------------------------------------
# 精排（Rerank）：RRF 融合后再用交叉编码器给 (query, chunk) 打分
#   链路：两路召回 → RRF 取 RERANK_CANDIDATES 条 → 精排 → 取 RETRIEVER_K 条
#   模型：qwen3.7-text-rerank（百炼 DashScope 原生接口，不是 OpenAI 兼容模式）
#   配 RERANK_API_KEY 即可启用，留空依次回退 DASHSCOPE_API_KEY、百炼域名下的
#   EMBEDDING_API_KEY；都没有时自动跳过，行为与旧版一致（只用 RRF）。精排失败
#   （超时/401/配额）只降精度，不会让问答失败。
# ---------------------------------------------------------------------------
RERANK_ENABLED=true
RERANK_MODEL=qwen3.7-text-rerank
RERANK_API_KEY=
# RERANK_ENDPOINT=               # 留空自动推导：百炼域名 + /api/v1/services/rerank/text-rerank/text-rerank
RERANK_CANDIDATES=30             # 送进精排的候选数（最终仍只返回 RETRIEVER_K 条）
# RERANK_MIN_SCORE=              # 0~1，低于该分丢弃；分数只在单次请求内可比，一般留空
# RERANK_INSTRUCT=               # 任务说明（仅 qwen3 系列支持），例如 Given a web search query, retrieve relevant passages that answer the query.
RERANK_TIMEOUT=10                # 单次精排请求超时秒数，超时自动退回 RRF 顺序

# 智能体循环预算（graph/budget.py，A-02）
#   单轮对话达到任一上限后，不再调用工具，转去 finalize 节点「基于已获得的资料作答，
#   并说明信息可能不完整」，而不是抛 GraphRecursionError / 返回 502。
#   0 表示该项不限制；recursion_limit 只是兜底（= 步数预算 × 2 + 2），由代码自动换算。
AGENT_MAX_TURNS=8                # 步数预算：单轮最多调用模型几次
AGENT_MAX_TOOL_CALLS=24          # 单轮最多真正执行几次工具调用（被跳过的重复调用不计）
AGENT_MAX_TOKENS=0               # 单轮 token 预算；0 = 不限制（provider 返回 usage 时才统计）
AGENT_MAX_SECONDS=600            # 单轮墙钟预算（秒）；0 = 不限制，不会中断正在跑的工具

# 通用 Agent 的会话记忆（MySQL tb_agent_chat_session / tb_agent_chat_message）
#   每轮从 MySQL 取最近 N 条 user / assistant 消息还原成上下文（工具调用记录只用于
#   界面回放，不进提示词）；会话列表默认返回多少条。
#   首次使用前先执行 docs/mysql/ 下的两个建表脚本。
AGENT_MEMORY_CANDIDATES=200
AGENT_MEMORY_SESSIONS=50

# 通用 Agent 上下文压缩（L1 工具预算 / L2 历史预算 / L3 滚动摘要）
#   历史预算 = 模型窗口 - 输出预留 - 安全余量 - 系统提示 - 工具 schema；
#   AGENT_CONTEXT_MAX_TOKENS>0 时再取较小值。中文按 2 字符/token 估算（越小越保守）。
#   摘要表首次使用前执行 docs/mysql/tb_agent_chat_summary.sql。
AGENT_MODEL_CONTEXT_TOKENS=32768
AGENT_CONTEXT_MAX_TOKENS=0
AGENT_OUTPUT_RESERVE_TOKENS=2048
AGENT_CONTEXT_SAFETY_TOKENS=512
AGENT_TOKEN_CHARS=2.0
AGENT_HISTORY_KEEP_MESSAGES=8
AGENT_MESSAGE_MAX_CHARS=8000
AGENT_TOOL_RESULT_MAX_CHARS=8000
AGENT_TOOL_RESULT_HEAD_CHARS=4096
AGENT_TOOL_RESULT_TAIL_CHARS=1024
AGENT_TOOL_TURN_MAX_CHARS=20000
AGENT_SUMMARY_ENABLED=true
AGENT_SUMMARY_TRIGGER_TOKENS=12000
AGENT_SUMMARY_KEEP_MESSAGES=8
AGENT_SUMMARY_MAX_CHARS=1200
AGENT_SUMMARY_MAX_TOKENS=1200
AGENT_SUMMARY_INPUT_MAX_CHARS=30000
AGENT_CONTEXT_OVERFLOW_RETRIES=1

# 通用工具（read / write / edit / glob / grep / shell）
#   文件工具只能访问 AGENT_WORKSPACE 内的路径，shell 的 cwd 也限制在这里；
#   默认项目根目录，相对路径按项目根目录解析。
# AGENT_WORKSPACE=.
AGENT_SHELL_TIMEOUT=120          # shell 默认超时秒数（单次调用可覆盖）
AGENT_SHELL_MAX_OUTPUT=20000     # shell 单路输出的最大字符数（超出按头尾截断）

# 工具调用策略（tools/policy.py，所有工具统一生效）
#   超时在工具节点用守护线程执行，卡住的工具会返回「工具执行超时」而不是挂住整张图；
#   只有知识库检索 / 联网搜索 / 网页抓取会重试，且只重试网络、429、5xx 这类临时失败。
AGENT_TOOL_TIMEOUT=60            # 单次工具调用硬超时秒数（shell 由命令 timeout 参数控制）
AGENT_TOOL_RETRIES=1             # 可重试工具的最大重试次数（0 = 不重试）
AGENT_TOOL_PARALLEL=true         # 同一轮多个工具是否并行（write / edit / shell 始终串行）

# ---------------------------------------------------------------------------
# 联网搜索（阿里云百炼 Web Search，DashScope 原生接口）
#   文档：https://help.aliyun.com/zh/model-studio/web-search
#   Key 留空时回退 DASHSCOPE_API_KEY；两者都没有时 web_search 工具调用会返回
#   配置提示（不影响图构建）。走原生接口是因为 OpenAI 兼容接口不返回来源列表。
# ---------------------------------------------------------------------------
# WEB_SEARCH_API_KEY=
WEB_SEARCH_BASE_URL=https://dashscope.aliyuncs.com/api/v1
WEB_SEARCH_MODEL=qwen-plus
# 搜索量级策略：留空用服务端默认（turbo）；可选 turbo / max / agent / agent_max
# WEB_SEARCH_STRATEGY=turbo
WEB_SEARCH_FORCED=true           # 强制联网，避免模型「觉得自己知道」跳过搜索
WEB_SEARCH_ENABLE_CITATION=true  # 打开 [ref_n] 角标标注
WEB_SEARCH_TIMEOUT=30

# ---------------------------------------------------------------------------
# 网页抓取（阿里云百炼 Web Extractor，OpenAI 兼容 Responses API）
#   文档：https://help.aliyun.com/zh/model-studio/web-extractor
#   LLM_BASE_URL 是百炼域名时，默认复用它的端点 / Key / 模型；
#   否则退回百炼公网端点 + WEB_SEARCH_API_KEY / DASHSCOPE_API_KEY。
#   模型必须支持 web_extractor（Qwen3.5-Plus 及以上 / Qwen3.7、3.8 系列）。
# ---------------------------------------------------------------------------
# WEB_EXTRACTOR_BASE_URL=         # 留空按上面的规则自动选择
# WEB_EXTRACTOR_API_KEY=          # 留空跟随 LLM_API_KEY 或 DASHSCOPE_API_KEY
# WEB_EXTRACTOR_MODEL=            # 留空跟随 LLM_MODEL
WEB_EXTRACTOR_TIMEOUT=120        # 抓取可能较慢（含模型思考与网页读取）
WEB_EXTRACTOR_MAX_CHARS=20000    # 回填给模型的正文上限，超出截断

# ---------------------------------------------------------------------------
# MinerU 精准解析 API（文档：https://mineru.net/apiManage/docs）
#   Token 申请：https://mineru.net/apiManage/token
#   精准解析 API：≤200MB / ≤600 页 / 支持批量，输出 zip（Markdown + JSON）
# ---------------------------------------------------------------------------
MINERU_API_KEY=
MINERU_BASE_URL=https://mineru.net/api/v4
MINERU_MODEL_VERSION=vlm        # pipeline | vlm（推荐） | MinerU-HTML（仅 html）
MINERU_LANGUAGE=ch
MINERU_ENABLE_FORMULA=true
MINERU_ENABLE_TABLE=true
MINERU_IS_OCR=false
MINERU_TIMEOUT=600              # 单个任务最长等待秒数
MINERU_POLL_INTERVAL=3          # 轮询间隔秒数
MINERU_MAX_CONCURRENT=2         # 同时进行的解析任务数
MINERU_MAX_FILE_MB=200
MINERU_OUTPUT_DIR=data/parsed   # 解析结果（Markdown + 图片）保存目录

# RAG 切片补删队列：删除文档时 Milvus 不可用，先落盘标记（一个 doc_id 一个 JSON），
# 后台重试；成功一条删一条。数据库挂了也不影响落盘，见 `rag/deletions.py`。
RAG_DELETE_PENDING_DIR=data/rag_delete_pending

# ---------------------------------------------------------------------------
# 阿里云 OSS（私域图片：私有 Bucket）
#   对接方式：服务端用 AccessKey 做 OSS V1 签名直连（不依赖 oss2 / 本地编译），
#   前端只拿 OSS 直链（OSSAccessKeyId + Expires + Signature），拿不到 AccessKey Secret。
#   安全模型：
#     * 页面打开时由 /api/oss/overview 用 OSS_ACCESS_TOKEN 派生 HttpOnly 会话 Cookie，
#       前端不需要输入口令；脚本仍可用请求头 X-OSS-Access 或 ?access= 显式访问；
#     * 图片读取统一走 OSS 预签名直链：url 用于预览，download_url 额外带上
#       response-content-disposition=attachment；有效期 OSS_URL_EXPIRES 秒；
#     * 直链是限时访问凭证，且无法用 OSS_ACCESS_TOKEN 吊销，只能等过期或轮换 AK；
#     * 对象全部落在 OSS_PREFIX/ 目录下，接口拒绝访问其他前缀。
#   控制台：https://oss.console.aliyun.com/
# ---------------------------------------------------------------------------
OSS_BUCKET=                      # Bucket 名，例如 agent3
OSS_ENDPOINT=https://oss-cn-shenzhen.aliyuncs.com   # 区域 Endpoint（不带 Bucket）
OSS_REGION=cn-shenzhen
OSS_ACCESS_KEY_ID=               # RAM 用户的 AccessKey ID
OSS_ACCESS_KEY_SECRET=           # RAM 用户的 AccessKey Secret
OSS_PREFIX=image3                # 只允许读写这个目录（对应控制台里的 image3/）
OSS_ACCESS_TOKEN=                # 访问口令，建议随机生成，至少 16 位
OSS_URL_EXPIRES=86400            # 签名 URL 有效期（秒）：60 ~ 2592000
OSS_MAX_FILE_MB=10               # 单张图片大小上限（MB）
OSS_ALLOWED_SUFFIXES=.jpg,.jpeg,.png,.gif,.webp,.bmp
OSS_TIMEOUT=60                   # 单次 OSS 请求超时（秒）
